# Copier en .env (chmod 600) à côté du docker-compose.yml
BASE_URL=https://ag.hacf.fr
LISTEN=:8080
DATA_DIR=/data
MAX_MANDATS=3
# Date limite de réponse (veille de l'AG à 23h59, heure de Paris) : à adapter
DEADLINE=2026-12-18T23:59:00+01:00
AG_NAME=Assemblée générale HACF
AG_DATE_TEXT=
CONTACT_EMAIL=contact@hacf.fr
# Groupe authentik autorisé pour /admin (si vide, /admin est désactivé)
ADMIN_GROUP=
HDR_USER=X-Authentik-Username
HDR_GROUPS=X-Authentik-Groups
